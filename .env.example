# Copy to `.env` and fill in real values. NEVER commit the real .env.
# v1 hardcoded RTSP credentials in source. v2 keeps every secret here.

# Anthropic Claude API key for the agentic layer (the agent "brain")
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud Vision: path to the GCP service-account key JSON (the "eyes": OCR + frame analysis)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# Camera credentials (referenced by config/config.yaml, kept out of that file)
GCM_ENTRY_CAM_RTSP=rtsp://USER:PASSWORD@CAMERA_HOST:554/media/video1
GCM_EXIT_CAM_RTSP=rtsp://USER:PASSWORD@CAMERA_HOST:554/media/video1

# Optional: where anomaly/watchdog alerts go (email, webhook, etc.)
GCM_ALERT_WEBHOOK=
